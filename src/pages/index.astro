---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Sven I. Frantzen | Shopify & Fullstack Developer';

const description = 'Sven Ingar Frantzen is a Shopify and fullstack developer building fast, accessible storefronts with Shopify Plus, Liquid, and GraphQL.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <p>Shopify & Fullstack Developer</p>

    <h1>I build fast, accessible e-commerce experiences.</h1>

    <p>Working with Shopify Plus, Liquid, GraphQL, JavaScript, and modern web technologies.</p>
  </section>
</BaseLayout>
