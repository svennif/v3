---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Sven Ingar Frantzen — Shopify & fullstack developer in Copenhagen';
const description = 'Shopify and fullstack developer in Copenhagen. Commerce storefronts, integrations and the services behind them.';

const prompt = 'sif@copenhagen:~$ whoami';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <p class="hero-whoami terminal-prompt" style={`--typing-steps:${prompt.length}`}>{prompt}</p>

    <h1 class="hero-name">Sven Ingar Frantzen</h1>
    <p class="hero-role">Fullstack &amp; Shopify developer</p>
  </section>
</BaseLayout>
