---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => b.data.year - a.data.year || b.data.order - a.data.order);

  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudy entry={entry} prev={prev} next={next}>
  <Content />
</CaseStudy>
