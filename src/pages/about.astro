---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About — Sven Ingar Frantzen';
const description =
  'Norwegian developer in Copenhagen, working in commerce since 2021. How I work, and what I have shipped.';

const prompt = 'sif@copenhagen:~$ cat about.md';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <p class="hero-whoami terminal-prompt" style={`--typing-steps:${prompt.length}`}>{prompt}</p>
    <h1 class="hero-name">about</h1>
  </section>
</BaseLayout>